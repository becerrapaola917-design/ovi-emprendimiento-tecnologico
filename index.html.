enter;gap:10px;flex-wrap:wrap}.tabs{display:flex;gap:5px;flex:1;overflow-x:auto}.tab{border:0;background:transparent;padding:11px 13px;color:#365367;border-radius:9px;font-weight:700;white-space:nowrap;font-size:13px}.tab.active{background:#e6f3f6;color:#005a73}.progresswrap{min-width:170px;display:flex;align-items:center;gap:8px;font-size:12px;font-weight:800}.progressbar{height:8px;background:#e6ebef;border-radius:20px;overflow:hidden;flex:1}.progressbar span{display:block;height:100%;background:linear-gradient(90deg,#168e93,#f29100);width:0;transition:width .35s}main{max-width:1200px;margin:32px auto 80px;padding:0 20px}.section{display:none;animation:fade .25s ease}.section.active{display:block}@keyframes fade{from{opacity:.2;transform:translateY(5px)}to{opacity:1;transform:none}}.sectionhead{margin:0 0 24px}.sectionhead p{color:var(--muted);max-width:850px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;box-shadow:var(--shadow)}.card.highlight{border-top:4px solid var(--gold)}.card h3{color:var(--navy)}.card p{color:#445e70}.full{grid-column:1/-1}.kicker{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#087c91;font-weight:800}.pill{display:inline-block;border-radius:20px;background:#edf5f6;padding:4px 9px;font-size:12px;color:#005e70;font-weight:700}.note{padding:13px 15px;background:#edf5f7;border-left:4px solid #087c91;border-radius:6px;color:#274b5e;font-size:13px}.warn{background:#fff6e8;border-left-color:var(--gold)}.btn{background:var(--blue);border:1px solid var(--blue);color:#fff;border-radius:9px;padding:10px 14px;font-weight:750}.btn.secondary{background:#fff;color:var(--blue)}.btn:disabled{opacity:.5;cursor:not-allowed}.btn:hover:not(:disabled){filter:brightness(1.08)}.buttonrow{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}.small{font-size:12px;color:var(--muted)}.option{display:block;width:100%;text-align:left;background:white;border:1px solid #d9e4e9;border-radius:10px;padding:12px 14px;margin:7px 0;color:var(--ink)}.option:hover{background:#f0f7f8}.option.selected{border:2px solid var(--cyan);background:#eaf5f6}.option.correct{border-color:var(--good);background:#e7f6ef}.option.incorrect{border-color:var(--bad);background:#fff0f0}.tablewrap{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:13px}th{background:#e9f1f4;color:#193b52;text-align:left}td,th{padding:11px 12px;border-bottom:1px solid #e1e9ed;vertical-align:top}label{display:block;font-weight:750;font-size:13px;margin:10px 0 5px}input[type=number],select{width:100%;padding:10px;border:1px solid #c8d7df;border-radius:8px;background:white}input[type=range]{width:100%;accent-color:#087c91}.value{font-weight:850;font-size:23px;color:var(--blue)}.pipeline{display:flex;flex-wrap:wrap;gap:7px;margin:16px 0}.step{flex:1 1 125px;border:1px solid #bed5dd;background:#f7fbfc;border-radius:12px;padding:13px 9px;text-align:center;min-height:85px}.step.active{background:#005e79;color:white;border-color:#005e79}.step span{display:block;font-size:12px}.step strong{font-size:13px}.feedback{padding:13px 14px;background:#f1f6f8;border-radius:9px;margin-top:12px;min-height:45px}.feedback.good{background:#e7f6ef;color:#125c48}.feedback.bad{background:#fff0f0;color:#812e31}.stat{padding:15px;background:#f1f7f9;border-radius:12px}.stat strong{font-size:25px;display:block;color:var(--blue)}.scenario{border-left:4px solid var(--gold);padding-left:16px}.check{display:flex;gap:10px;align-items:flex-start;padding:11px 0;border-bottom:1px solid var(--line);font-size:14px}.check input{margin-top:5px;accent-color:#087c91}.q{margin-bottom:20px;padding-bottom:18px;border-bottom:1px solid var(--line)}.q strong{display:block;margin-bottom:12px}.sources a{color:#006b88;overflow-wrap:anywhere}.sources li{margin:9px 0}.footer{border-top:1px solid var(--line);padding:24px 20px;text-align:center;color:var(--muted);font-size:12px}.modal{position:fixed;inset:0;background:#0b2638b9;display:none;align-items:center;justify-content:center;z-index:30;padding:20px}.modal.open{display:flex}.modalbox{background:white;border-radius:20px;padding:32px;max-width:550px;width:100%;box-shadow:0 25px 70px #001e3490;text-align:center}.modalbox .medal{font-size:65px}.certificate{border:2px solid #c79b41;padding:26px;background:#fffefa}.certificate h2{color:var(--blue)}.footactions{display:flex;gap:9px;justify-content:space-between;flex-wrap:wrap;margin-top:26px}.tag{font-size:11px;background:#fff0d8;color:#795000;border-radius:5px;padding:3px 7px}.fieldrow{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:800px){.hero,.grid,.grid3{grid-template-columns:1fr}.hero-graphic{display:none}.fieldrow{grid-template-columns:1fr}.navinner{padding:8px}.tabs{order:2;width:100%}.progresswrap{margin-left:auto}header{padding:22px 20px}.card{padding:17px}}@media print{header,.sticky,.footactions,.btn,.modal .buttonrow{display:none!important}.modal{position:static;background:white}.modalbox{box-shadow:none;max-width:none}.section{display:none!important}body{background:white}}
</style></head><body>
<header><div class="top"><div class="identity"><div class="mark" aria-label="Identificador textual UNAD">UNAD</div><div><strong>Universidad Nacional Abierta y a Distancia</strong><div class="meta">ECBTI · Ingeniería Industrial · Emprendimiento Tecnológico</div></div></div><div class="meta">OVI académico de apoyo · Fase 2<br>Duración orientativa: 45–60 minutos · Caso simulado</div></div><div class="hero"><div><div class="eyebrow">Laboratorio interactivo de decisiones industriales</div><h1>De la biodiversidad colombiana a una planta cosmética viable</h1><p>Un caso guiado de ingeniería industrial para seleccionar una necesidad territorial, diseñar una solución tecnológica y justificar decisiones con evidencia, cálculos y criterios regulatorios.</p><div class="buttonrow"><button class="btn" onclick="go(0)">Comenzar recorrido →</button><span class="pill">Caso: emulsión cosmética con aceite de cacay</span></div></div><div class="hero-graphic"><div class="kicker" style="color:#bde9ee">Reto de diseño</div><div class="metric">600 <small>unidades / turno</small></div><div class="rule"></div><small>Meta de producción hipotética. ¿Puede una planta piloto cumplirla sin comprometer calidad ni trazabilidad?</small><div style="margin-top:20px" class="meta">5 decisiones · 4 estaciones · 1 caso integrador</div></div></div></header>
<nav class="sticky" aria-label="Navegación del OVI"><div class="navinner"><div class="tabs" role="tablist"><button class="tab active" onclick="go(0)" role="tab" aria-selected="true">01 · Decidir el reto</button><button class="tab" onclick="go(1)" role="tab">02 · Diseñar el proceso</button><button class="tab" onclick="go(2)" role="tab">03 · Validar viabilidad</button><button class="tab" onclick="go(3)" role="tab">04 · Demostrar dominio</button></div><div class="progresswrap"><span id="pct">0%</span><div class="progressbar" aria-label="Progreso del OVI"><span id="bar"></span></div></div></div></nav>
<main>
<section class="section active" id="s0"><div class="sectionhead"><span class="kicker">Estación 01 · Anexo 2: pasos 1 y 2</span><h2>Una necesidad real antes que una solución atractiva</h2><p>En la Fase 1 cada integrante identifica problemáticas. En la Fase 2 el equipo debate, selecciona una problemática común y compara soluciones tecnológicas industriales.</p></div><div class="grid"><article class="card highlight"><h3>El contexto territorial</h3><p>Una asociación de transformadores de materias primas vegetales busca aumentar el valor agregado local. El grupo explora una planta piloto para formular y envasar una emulsión cosmética con aceite de cacay (<i>Caryodendron orinocense</i>).</p><div class="note warn"><b>Supuesto pedagógico:</b> la asociación, las cifras de producción y los costos son ficticios. El caso no afirma que exista una planta real ni que el aceite de cacay tenga beneficios clínicos demostrados.</div></article><article class="card"><h3>Debate rápido de problemáticas</h3><p>¿Cuál problema justificaría mejor una intervención de Ingeniería Industrial? Selecciona una opción y observa el criterio de decisión.</p><button class="option" onclick="chooseProblem(0,this)">A. La asociación no tiene una página web de ventas.</button><button class="option" onclick="chooseProblem(1,this)">B. Hay pérdidas de materia prima, baja estandarización y poca trazabilidad en la transformación.</button><button class="option" onclick="chooseProblem(2,this)">C. La marca aún no tiene un eslogan comercial.</button><div id="problemFb" class="feedback" aria-live="polite">Selecciona la problemática con mayor potencial para un diseño tecnológico industrial sustentable.</div></article><article class="card full"><div class="kicker">Decisión de ingeniería</div><h3>Comparador multicriterio de alternativas</h3><p>Modifica los pesos de evaluación. El modelo normaliza los pesos automáticamente y calcula un puntaje ponderado de 1 a 5. Las calificaciones son <b>supuestos didácticos</b>, no resultados de una investigación de mercado.</p><div class="fieldrow"><div><label for="w1">Aporte al proceso: <span id="wl1">45</span>%</label><input id="w1" type="range" min="1" max="100" value="45" oninput="rank()"></div><div><label for="w2">Factibilidad técnica: <span id="wl2">35</span>%</label><input id="w2" type="range" min="1" max="100" value="35" oninput="rank()"></div><div><label for="w3">Trazabilidad y calidad: <span id="wl3">20</span>%</label><input id="w3" type="range" min="1" max="100" value="20" oninput="rank()"></div></div><div class="tablewrap"><table><thead><tr><th>Alternativa</th><th>Proceso</th><th>Factibilidad</th><th>Calidad</th><th>Puntaje / 5</th></tr></thead><tbody id="rankbody"></tbody></table></div><div class="feedback" id="rankFb" aria-live="polite"></div><div class="note"><b>Discusión grupal:</b> la matriz no sustituye la evidencia. En un proyecto real cada calificación debe sustentarse con requisitos, costos, disponibilidad de equipos y fuentes técnicas.</div></article><article class="card"><h3>Materia prima y diseño responsable</h3><p><b>Cacay:</b> aceite vegetal obtenido de semillas de <i>Caryodendron orinocense</i>. En cosmética puede actuar como componente emoliente, pero la compatibilidad, estabilidad, seguridad y especificaciones deben comprobarse en la formulación.</p><p><b>Cacao:</b> <i>Theobroma cacao</i>, diferente especie. La manteca de cacao es otra materia prima cosmética.</p><span class="tag">No confundir cacay con cacao</span></article><article class="card"><h3>Salida exigible del Anexo 2</h3><p>El grupo debe registrar la problemática elegida, la justificación de su selección, los criterios de evaluación de alternativas y los aportes de cada integrante.</p><div class="note">El debate inicial es breve: la mayor parte de la Fase 2 se destina al diseño y formulación de la solución tecnológica.</div></article></div><div class="footactions"><span class="small">Completa la decisión sobre la problemática y revisa la matriz.</span><button class="btn" onclick="complete(0);go(1)">Continuar a ingeniería →</button></div></section>
<section class="section" id="s1"><div class="sectionhead"><span class="kicker">Estación 02 · Anexo 2: paso 3</span><h2>Del concepto a un proceso industrial medible</h2><p>Explora la ruta productiva, los equipos y las variables críticas. Luego utiliza el simulador para evaluar la capacidad de una planta piloto.</p></div><div class="card"><div class="kicker">Mapa de proceso interactivo</div><div class="pipeline" id="pipeline"></div><div class="grid"><div><h3 id="procTitle"></h3><p id="procDesc"></p><div class="note" id="procNorm"></div></div><div><div class="stat"><span class="kicker">Variable / parámetro de referencia</span><p id="procParam"></p><span class="kicker">Equipo o infraestructura</span><p id="procEquip"></p></div></div></div><p class="small">Los valores de proceso son orientativos y no constituyen una fórmula cosmética validada. La temperatura, el tiempo y el régimen de mezclado deben definirse mediante ensayos y especificaciones de cada ingrediente.</p></div><div class="grid" style="margin-top:18px"><article class="card highlight"><h3>Simulador: balance de masa y capacidad</h3><p>Escenario ilustrativo: emulsión en envases de 100 g, turno de 8 horas. Modifica parámetros y analiza la restricción.</p><div class="fieldrow"><div><label for="batch">Tamaño del lote (kg)</label><input id="batch" type="number" min="5" max="500" step="5" value="60" oninput="simulate()"></div><div><label for="loss">Merma del proceso (%)</label><input id="loss" type="number" min="0" max="40" step="0.5" value="5" oninput="simulate()"></div><div><label for="cycle">Tiempo por lote (min)</label><input id="cycle" type="number" min="10" max="480" step="5" value="90" oninput="simulate()"></div></div><div class="grid3" style="margin-top:16px"><div class="stat"><small>Producto conforme / lote</small><strong id="outkg">—</strong></div><div class="stat"><small>Envases / turno</small><strong id="units">—</strong></div><div class="stat"><small>Uso de capacidad meta</small><strong id="util">—</strong></div></div><div id="simFb" class="feedback"></div><p class="small">Modelo: masa útil = lote × (1 − merma); lotes enteros = piso(480 / tiempo de ciclo); unidades = piso(masa útil total / 0,1 kg). No incluye tiempos paralelos, limpieza adicional ni paradas no planificadas.</p></article><article class="card"><h3>Detecta el cuello de botella</h3><p>Si la mezcla produce 600 unidades por turno, pero la llenadora solo procesa 420, ¿qué operación limita la salida del sistema?</p><button class="option" onclick="bottle(0,this)">Mezcla, porque prepara el producto.</button><button class="option" onclick="bottle(1,this)">Envasado, porque su capacidad es menor.</button><button class="option" onclick="bottle(2,this)">Ninguna: basta con aumentar el inventario.</button><div id="bottleFb" class="feedback">Aplica el principio de capacidad del sistema: la producción sostenible está limitada por la operación restrictiva.</div><h3 style="margin-top:20px">Herramientas aplicables</h3><div class="buttonrow"><button class="btn secondary" onclick="toolbox('dmaic')">DMAIC</button><button class="btn secondary" onclick="toolbox('trl')">TRL</button><button class="btn secondary" onclick="toolbox('canvas')">Lean Canvas</button></div><div id="toolFb" class="feedback">Selecciona una herramienta para conocer su uso correcto en este proyecto.</div></article></div><div class="footactions"><button class="btn secondary" onclick="go(0)">← Anterior</button><button class="btn" onclick="complete(1);go(2)">Continuar a viabilidad →</button></div></section>
<section class="section" id="s2"><div class="sectionhead"><span class="kicker">Estación 03 · Anexo 2: paso 4</span><h2>Diseñar no es lo mismo que demostrar viabilidad</h2><p>La verificación conceptual identifica hipótesis y pruebas futuras; la formulación I+D+i estructura actividades, responsables, recursos, riesgos e indicadores.</p></div><div class="grid"><article class="card"><h3>Caso guiado: la línea no cumple la demanda</h3><div class="scenario"><p id="caseText"></p></div><div class="buttonrow"><button class="btn secondary" onclick="caseStep(-1)">← Atrás</button><span class="pill" id="caseCount">1 / 3</span><button class="btn" onclick="caseStep(1)">Siguiente →</button></div></article><article class="card highlight"><h3>Control regulatorio y de viabilidad</h3><p>Marca los aspectos que el equipo ya <b>documentó</b> en su propuesta. Esto es una lista orientadora, no una autorización sanitaria.</p><div id="checks"></div><div class="feedback" id="checkFb"></div><div class="note warn">Para comercializar cosméticos en Colombia deben verificarse las disposiciones vigentes de la Comunidad Andina y las exigencias aplicables ante INVIMA, incluida la Notificación Sanitaria Obligatoria cuando corresponda. No confundir NSO con un registro sanitario genérico.</div></article><article class="card full"><h3>Ficha mínima de formulación I+D+i</h3><div class="tablewrap"><table><thead><tr><th>Componente</th><th>Ejemplo orientador del caso</th><th>Evidencia esperada del estudiante</th></tr></thead><tbody><tr><td>Problema</td><td>Baja estandarización y trazabilidad del procesamiento local</td><td>Necesidad priorizada y justificada por el grupo</td></tr><tr><td>Solución</td><td>Proceso piloto de formulación, control y envasado</td><td>Diagrama, equipos, parámetros y requisitos funcionales</td></tr><tr><td>Hipótesis</td><td>El proceso puede alcanzar una capacidad meta bajo criterios de calidad definidos</td><td>Plan de prueba y variables observables; sin afirmar resultados inexistentes</td></tr><tr><td>Indicadores</td><td>Unidades conformes/turno, merma, rechazos, trazabilidad por lote</td><td>Fórmulas, metas preliminares y método de medición</td></tr><tr><td>Riesgos</td><td>Inestabilidad, contaminación, suministro irregular, sobrecostos</td><td>Controles y responsables</td></tr><tr><td>Gestión</td><td>Actividades, cronograma, roles y recursos</td><td>Insumos para el presupuesto asistido por IA del Anexo 3</td></tr></tbody></table></div><div class="note">ISO 56002 puede orientar la gestión de innovación, pero no es una plantilla obligatoria de formulación. El TRL se justifica según la evidencia disponible, no por la sofisticación del lenguaje empleado.</div></article></div><div class="footactions"><button class="btn secondary" onclick="go(1)">← Anterior</button><button class="btn" onclick="complete(2);go(3)">Ir a evaluación →</button></div></section>
<section class="section" id="s3"><div class="sectionhead"><span class="kicker">Estación 04 · Anexo 2: paso 5</span><h2>Demuestra que puedes tomar decisiones de ingeniería</h2><p>Responde cinco preguntas de aplicación. Cada respuesta ofrece retroalimentación inmediata. Para obtener el reconocimiento educativo debes alcanzar al menos 80% y visitar las cuatro estaciones.</p></div><div class="grid"><article class="card full"><div id="quiz"></div><div class="buttonrow"><button class="btn" onclick="grade()">Calcular resultado</button><button class="btn secondary" onclick="resetQuiz()">Reintentar</button></div><div id="scoreFb" class="feedback" aria-live="polite">Selecciona una opción en cada pregunta.</div></article><article class="card"><h3>Transferencia al trabajo colaborativo</h3><p>En el Anexo 2 real, el grupo debe consolidar su decisión, el diseño, las fuentes, los aportes individuales y las evidencias requeridas por la guía vigente, incluidas las de Cisco cuando correspondan.</p><div class="note">Este OVI es un ejemplo de apoyo: no reemplaza el Anexo 2 ni la rúbrica oficial.</div></article><article class="card"><h3>Reconocimiento de aprendizaje</h3><p>Al completar el recorrido y aprobar el cuestionario podrás generar una constancia <b>no oficial</b>, imprimible desde el navegador.</p><button class="btn" id="awardBtn" disabled onclick="showAward()">Ver reconocimiento</button><p class="small">No se recopilan nombres ni se envían respuestas a un servidor. El progreso existe solo durante esta sesión.</p></article><article class="card full sources"><h3>Fuentes y criterios de verificación</h3><ol><li>OECD/Eurostat (2018). <i>Oslo Manual 2018: Guidelines for Collecting, Reporting and Using Data on Innovation.</i> <a href="https://doi.org/10.1787/9789264304604-en" target="_blank" rel="noopener">DOI oficial</a>.</li><li>ISO (2019). <i>ISO 56002:2019 — Innovation management — Innovation management system — Guidance.</i> <a href="https://www.iso.org/standard/68221.html" target="_blank" rel="noopener">Ficha de la norma</a>.</li><li>INVIMA. Portal institucional para consulta de requisitos y trámites de cosméticos. <a href="https://www.invima.gov.co/" target="_blank" rel="noopener">Sitio oficial</a>.</li><li>Comunidad Andina. Decisión 833 (armonización de legislaciones en materia de productos cosméticos). Consultar texto vigente y disposiciones complementarias en fuentes oficiales.</li><li>NASA. <i>Technology Readiness Levels (TRL).</i> Marco orientador de madurez tecnológica; adaptar su interpretación al tipo de solución.</li></ol><div class="note warn"><b>Alcance:</b> todas las cifras del caso, capacidades, puntuaciones y costos potenciales son ejemplos de aprendizaje. Ninguna formulación cosmética, proceso o alegación comercial queda validada por este recurso. Los requisitos regulatorios deben revisarse en su versión vigente antes de cualquier implementación.</div></article></div><div class="footactions"><button class="btn secondary" onclick="go(2)">← Anterior</button><button class="btn secondary" onclick="window.print()">Imprimir página</button></div></section>
</main><footer class="footer">UNAD · ECBTI · OVI de apoyo académico para Fase 2 · Prototipo didáctico sujeto a validación de la Red Docente. Sin carácter de certificación institucional.</footer>
<div class="modal" id="award" role="dialog" aria-modal="true" aria-labelledby="awardTitle"><div class="modalbox"><div class="certificate"><div class="medal">🏅</div><div class="kicker">Reconocimiento educativo no oficial</div><h2 id="awardTitle">Dominio del caso de ingeniería</h2><p>Has completado el laboratorio de decisiones de la Fase 2 y demostrado comprensión de la selección de problemas, diseño de procesos, viabilidad y formulación I+D+i.</p><p><strong id="awardScore"></strong></p><p class="small">Material didáctico de apoyo. No equivale a certificado, nota o aval de la UNAD.</p></div><div class="buttonrow" style="justify-content:center"><button class="btn" onclick="window.print()">Imprimir reconocimiento</button><button class="btn secondary" onclick="document.getElementById('award').classList.remove('open')">Cerrar</button></div></div></div>
<script>
'use strict';const visited=[false,false,false,false],done=[false,false,false,false];let score=0,passed=false,caseIndex=0;function go(i){document.querySelectorAll('.section').forEach((e,j)=>e.classList.toggle('active',i===j));document.querySelectorAll('.tab').forEach((e,j)=>{e.classList.toggle('active',i===j);e.setAttribute('aria-selected',String(i===j))});visited[i]=true;progress();window.scrollTo({top:0,behavior:'smooth'})}function complete(i){done[i]=true;progress()}function progress(){const count=visited.filter(Boolean).length;const p=Math.round((count/4)*80+(passed?20:0));document.getElementById('pct').textContent=p+'%';document.getElementById('bar').style.width=p+'%';document.getElementById('awardBtn').disabled=!(p===100&&passed)}
function chooseProblem(i,el){document.querySelectorAll('#s0 .card:nth-child(2) .option').forEach(b=>b.classList.remove('selected'));el.classList.add('selected');document.getElementById('problemFb').innerHTML=i===1?'<b>Decisión bien fundamentada.</b> La pérdida de material, la variabilidad y la falta de trazabilidad se pueden traducir en requisitos de proceso, indicadores y alternativas industriales. Aún habría que confirmar el problema con evidencia territorial.':'Esta situación puede ser relevante, pero no describe por sí sola el problema técnico central. Compara impacto, evidencia y oportunidad de intervención industrial.'}
const alternatives=[['Línea piloto con control de proceso y trazabilidad',5,3,5],['Aplicación de ventas sin integración industrial',2,5,1],['Servicio externo de envasado con control de lotes',3,4,4]];function rank(){const raw=[1,2,3].map(i=>+document.getElementById('w'+i).value);raw.forEach((v,i)=>document.getElementById('wl'+(i+1)).textContent=v);const total=raw.reduce((a,b)=>a+b,0);const rows=alternatives.map(a=>({a,s:(a[1]*raw[0]+a[2]*raw[1]+a[3]*raw[2])/total})).sort((a,b)=>b.s-a.s);document.getElementById('rankbody').innerHTML=rows.map((r,i)=>'<tr><td>'+(i===0?'★ ':'')+r.a[0]+'</td><td>'+r.a[1]+'</td><td>'+r.a[2]+'</td><td>'+r.a[3]+'</td><td><b>'+r.s.toFixed(2)+'</b></td></tr>').join('');document.getElementById('rankFb').textContent='Alternativa mejor puntuada con los pesos actuales: '+rows[0].a[0]+'. Pesos normalizados: '+raw.map(v=>(100*v/total).toFixed(0)+'%').join(' · ')+'.'}
const process=[{name:'Recepción',desc:'Verificar identidad, lote, proveedor y especificaciones de las materias primas; establecer trazabilidad desde el ingreso.',param:'Identidad, integridad de envases, certificados y criterios de aceptación.',equip:'Área de recepción, balanza calibrada, registro de lotes.',norm:'Control documental y de proveedores; buenas prácticas de manufactura aplicables.'},{name:'Pesaje',desc:'Dosificar ingredientes según una fórmula aprobada para ensayo; evitar errores de identificación y cantidades.',param:'Masa por ingrediente y tolerancia de pesaje definida por especificación.',equip:'Balanzas adecuadas, recipientes identificados y hojas de lote.',norm:'Trazabilidad, calibración y prevención de mezclas accidentales.'},{name:'Preparación',desc:'Preparar fases acuosa y oleosa según compatibilidad y requisitos de formulación.',param:'Temperatura y tiempo definidos experimentalmente para cada formulación.',equip:'Tanques sanitarios, agitación y medición de temperatura.',norm:'Control de contaminación y registros de proceso.'},{name:'Emulsificación',desc:'Combinar fases y obtener dispersión estable bajo condiciones controladas.',param:'Velocidad de mezcla, tiempo, temperatura, aspecto y viscosidad objetivo.',equip:'Mezclador o homogeneizador, instrumentación.',norm:'Parámetros críticos y controles en proceso; validar estabilidad.'},{name:'Envasado',desc:'Llenar, cerrar y codificar recipientes para asegurar cantidad nominal e identificación del lote.',param:'Masa de llenado, rendimiento, integridad de cierre y velocidad de línea.',equip:'Llenadora, cerradora, codificadora y balanza de verificación.',norm:'Inspección de producto, etiquetado y trazabilidad.'},{name:'Liberación',desc:'Revisar registros y resultados de calidad antes de disponer del lote.',param:'Criterios de aceptación de estabilidad, microbiología y características pertinentes.',equip:'Área de cuarentena, muestreo y laboratorios propios o contratados.',norm:'Especificaciones, evidencia de conformidad y requisitos sanitarios vigentes.'}];function inspect(i){document.querySelectorAll('.step').forEach((e,j)=>e.classList.toggle('active',i===j));const p=process[i];document.getElementById('procTitle').textContent=(i+1)+'. '+p.name;document.getElementById('procDesc').textContent=p.desc;document.getElementById('procParam').textContent=p.param;document.getElementById('procEquip').textContent=p.equip;document.getElementById('procNorm').textContent=p.norm}document.getElementById('pipeline').innerHTML=process.map((p,i)=>'<button class="step" onclick="inspect('+i+')"><span>Operación '+(i+1)+'</span><strong>'+p.name+'</strong></button>').join('');inspect(0);
function simulate(){let b=+document.getElementById('batch').value,l=+document.getElementById('loss').value,t=+document.getElementById('cycle').value;if(!(b>0&&b<=500&&l>=0&&l<=40&&t>=10&&t<=480)){document.getElementById('simFb').textContent='Introduce valores válidos: lote 1–500 kg, merma 0–40%, ciclo 10–480 min.';return}let useful=b*(1-l/100),lots=Math.floor(480/t),units=Math.floor(useful*lots/0.1),util=units/600*100;document.getElementById('outkg').textContent=useful.toFixed(1)+' kg';document.getElementById('units').textContent=units.toLocaleString('es-CO');document.getElementById('util').textContent=util.toFixed(0)+'%';document.getElementById('simFb').innerHTML=units>=600?'La capacidad calculada supera la meta hipotética de 600 unidades. <b>Esto no demuestra viabilidad:</b> falta revisar llenado, calidad, paradas y demanda.':'La capacidad calculada es inferior a la meta hipotética. Revisa tiempo de ciclo, tamaño de lote y merma antes de proponer inversiones.'}simulate();function bottle(i,el){document.querySelectorAll('#s1 .card:nth-child(2) .option').forEach(b=>b.classList.remove('selected'));el.classList.add('selected');document.getElementById('bottleFb').textContent=i===1?'Correcto: el envasado restringe la salida a 420 unidades/turno, aunque mezcla tenga capacidad de 600. La mejora debe evaluarse con datos de tiempos y calidad.':'Revisa la capacidad de cada operación. El sistema no puede sostener una salida superior a la de su etapa restrictiva.'}function toolbox(s){const t={dmaic:'DMAIC: definir el problema medible; medir merma y capacidad; analizar causas; mejorar el proceso; controlar mediante indicadores. Es una metodología de mejora, no una prueba automática de innovación.',trl:'TRL: nivel de madurez tecnológica estimado a partir de evidencia verificable. Un esquema conceptual no demuestra un prototipo validado; justificar el nivel y las pruebas pendientes.',canvas:'Lean Canvas: hipótesis de segmentos, problema, propuesta de valor, canales, costos e ingresos. Complementa, pero no reemplaza, el diseño técnico de la planta.'};document.getElementById('toolFb').textContent=t[s]}
const cases=['Paso 1 · Diagnóstico: el equipo observa una meta de 600 envases por turno. El mezclado tiene capacidad teórica de 600 y el envasado de 420. El grupo debe identificar la restricción antes de adquirir equipos.','Paso 2 · Alternativas: se comparan una llenadora semiautomática, cambios de método y tercerización parcial. Deben evaluarse capacidad, calidad, costo total, riesgos y disponibilidad de servicio técnico.','Paso 3 · Verificación: se propone medir unidades conformes por hora, variabilidad de llenado y rechazos en una prueba piloto. No se declara éxito hasta obtener resultados reproducibles y cumplir requisitos aplicables.'];function caseStep(d){caseIndex=Math.max(0,Math.min(2,caseIndex+d));document.getElementById('caseText').textContent=cases[caseIndex];document.getElementById('caseCount').textContent=(caseIndex+1)+' / 3'}caseStep(0);
const checklist=['Se definió el uso cosmético y se identificaron los requisitos sanitarios aplicables.','Se consultaron las disposiciones vigentes sobre Notificación Sanitaria Obligatoria y etiquetado.','Se describieron buenas prácticas de manufactura, limpieza y control de contaminación.','Se planteó un programa de pruebas de estabilidad, calidad y seguridad pertinente.','Se evaluó el origen legal y la trazabilidad de materias primas.','Se identificaron impactos ambientales, residuos y obligaciones según ubicación y operación.','Se estimaron capacidad, recursos, costos y riesgos sin confundir estimaciones con resultados.'];document.getElementById('checks').innerHTML=checklist.map((s,i)=>'<label class="check"><input type="checkbox" onchange="checksUpdate()" id="c'+i+'"><span>'+s+'</span></label>').join('');function checksUpdate(){const n=checklist.filter((_,i)=>document.getElementById('c'+i).checked).length;document.getElementById('checkFb').textContent=n+' de '+checklist.length+' aspectos documentados según tu autoevaluación. Esta selección no verifica cumplimiento legal.'}checksUpdate();
const questions=[{q:'El grupo identifica tres problemas de la Fase 1. ¿Qué decisión corresponde al inicio de la Fase 2?',a:['Elegir el que tenga el nombre más innovador.','Debatir y seleccionar uno con criterios y evidencia territorial.','Diseñar tres plantas completas antes de elegir.'],c:1,e:'La selección conjunta, temprana y argumentada evita dispersión y permite dedicar el esfuerzo al diseño técnico.'},{q:'Una propuesta consiste solo en una tienda web. ¿Qué la fortalecería desde Ingeniería Industrial?',a:['Agregar más colores a la interfaz.','Integrar trazabilidad por lote, operaciones, control de inventarios e indicadores medibles.','Cambiar el nombre comercial.'],c:1,e:'La tecnología debe resolver un problema de proceso o sistema con funcionamiento y valor verificables.'},{q:'Una línea mezcla 600 unidades/turno y envasa 420. ¿Cuál es su salida máxima sostenible sin cambios?',a:['420 unidades/turno.','600 unidades/turno.','1.020 unidades/turno.'],c:0,e:'La operación restrictiva limita el flujo; acumular inventario antes de ella no eleva la capacidad final.'},{q:'El equipo dibujó el proceso y estimó un TRL. ¿Cuál afirmación es válida?',a:['Ya demostró estabilidad y seguridad cosmética.','Ya obtuvo autorización de comercialización.','Debe justificar la madurez con evidencia y planear pruebas de hipótesis.'],c:2,e:'Un diseño conceptual es evidencia de diseño, no de validación experimental, autorización sanitaria ni eficacia.'},{q:'¿Qué actuación es adecuada frente a la normativa cosmética colombiana?',a:['Revisar requisitos vigentes de INVIMA y Comunidad Andina, incluida NSO cuando aplique.','Asumir que todo cosmético requiere un registro sanitario idéntico al de medicamentos.','Comercializar primero y verificar requisitos después.'],c:0,e:'La ruta regulatoria depende del producto y de las disposiciones vigentes; la NSO es una figura clave para cosméticos en la Comunidad Andina.'}];let answers=Array(questions.length).fill(null);function renderQuiz(){document.getElementById('quiz').innerHTML=questions.map((q,i)=>'<div class="q"><span class="kicker">Situación '+(i+1)+' / '+questions.length+'</span><strong>'+q.q+'</strong>'+q.a.map((a,j)=>'<button class="option" id="q'+i+'a'+j+'" onclick="answer('+i+','+j+')">'+String.fromCharCode(65+j)+'. '+a+'</button>').join('')+'<div class="feedback" id="qf'+i+'" aria-live="polite">Elige una respuesta para recibir retroalimentación.</div></div>').join('')}function answer(i,j){answers[i]=j;const q=questions[i];q.a.forEach((_,k)=>{const e=document.getElementById('q'+i+'a'+k);e.className='option'+(k===j?' selected':'')+(k===j?(j===q.c?' correct':' incorrect'):'')});const fb=document.getElementById('qf'+i);fb.className='feedback '+(j===q.c?'good':'bad');fb.innerHTML='<b>'+(j===q.c?'Correcto. ':'Revisa tu decisión. ')+'</b>'+q.e}function grade(){if(answers.some(a=>a===null)){document.getElementById('scoreFb').textContent='Responde las cinco situaciones antes de calcular tu resultado.';return}score=answers.reduce((s,a,i)=>s+(a===questions[i].c?1:0),0);passed=score>=4;complete(3);progress();document.getElementById('scoreFb').innerHTML='<b>Resultado: '+score+'/5 ('+(score*20)+'%).</b> '+(passed?'Aprobaste. Visita las cuatro estaciones para activar el reconocimiento.':'Necesitas al menos 4 respuestas correctas. Revisa la retroalimentación y vuelve a intentarlo.')}function resetQuiz(){answers=Array(questions.length).fill(null);score=0;passed=false;renderQuiz();document.getElementById('scoreFb').textContent='Selecciona una opción en cada pregunta.';progress()}function showAward(){if(!(visited.every(Boolean)&&passed))return;document.getElementById('awardScore').textContent='Resultado de evaluación: '+score+'/5';document.getElementById('award').classList.add('open')}document.getElementById('award').addEventListener('click',e=>{if(e.target.id==='award')e.target.classList.remove('open')});document.addEventListener('keydown',e=>{if(e.key==='Escape')document.getElementById('award').classList.remove('open')});renderQuiz();rank();go(0);
</script></body></html>
